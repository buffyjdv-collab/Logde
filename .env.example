# ─── Database (Neon PostgreSQL) ────────────────────────────────────────────
# Copy this file to .env and fill in your Neon credentials.
# We use NEON_DATABASE_URL / NEON_DIRECT_URL to avoid conflicts with any
# stale DATABASE_URL system env var.
NEON_DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require&pgbouncer=true"
NEON_DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# ─── Session ────────────────────────────────────────────────────────────────
# Used to sign httpOnly session cookies. Generate a long random string.
# Run: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"
