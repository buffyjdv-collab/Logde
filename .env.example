# ─── Database (Neon PostgreSQL) ────────────────────────────────────────────
# Copy this file to .env and fill in your Neon credentials.
# DATABASE_URL uses the pooled connection (PgBouncer) for app runtime.
# DIRECT_URL uses the direct (non-pooled) connection for Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# ─── Session ────────────────────────────────────────────────────────────────
# Used to sign httpOnly session cookies. Generate a long random string.
# Run: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"
