// LodgeHub — Prisma schema (SQLite)
// Multi-tenant Lodge Management SaaS with molecular RBAC + platform fee system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Multi-Tenant Foundation ────────────────────────────────────────────────

model Tenant {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  contactEmail  String
  contactPhone  String?
  address       String?
  logoUrl       String?
  plan          String   @default("starter") // starter | growth | scale | enterprise
  status        String   @default("active") // active | suspended | cancelled
  currency      String   @default("INR")
  timezone      String   @default("Asia/Kolkata")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  properties    Property[]
  users         User[]
  roles         Role[]
  roomTypes     RoomType[]
  rooms         Room[]
  guests        Guest[]
  bookings      Booking[]
  payments      Payment[]
  invoices      Invoice[]
  expenses      Expense[]
  housekeeping  HousekeepingTask[]
  notifications Notification[]
  auditLogs     AuditLog[]
  subscription  TenantSubscription?
  platformFeeConfig  PlatformFeeConfig?
  platformFeePayments PlatformFeePayment[]
}

model Property {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  address   String?
  city      String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rooms    Room[]
  users    User[]
}

// ─── RBAC: Molecular Permission System ──────────────────────────────────────
//
// Permission = a granular capability key like "bookings.create", "rooms.edit_status".
// Role = a named bundle of permissions, scoped to a tenant (or system for super_admin).
// User → Role → Permissions.
// Menu visibility is derived from permissions (each nav item declares a required
// permission key).

model Permission {
  id          String @id @default(cuid())
  key         String @unique // e.g. "bookings.create"
  module      String // bookings | rooms | guests | payments | expenses | housekeeping | reports | staff | settings | dashboard | frontdesk | tenants | platform
  action      String // view | create | edit | delete | checkin | checkout | cancel | manage_roles | manage_fees | ...
  label       String // human-friendly
  description String?
  isSuperAdmin Boolean @default(false) // true for platform-level permissions only super_admin can hold

  roles RolePermission[]
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String?  // null = global/system role (super_admin, platform_owner)
  name        String   // super_admin | owner | manager | receptionist | housekeeping | accountant | custom-xxx
  label       String
  description String?
  isSystem    Boolean  @default(false) // system roles cannot be deleted
  isSuperAdmin Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       User[]
  menuItems   String   @default("[]") // JSON array of nav item keys explicitly assigned

  @@unique([tenantId, name])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model User {
  id        String   @id @default(cuid())
  tenantId  String   // super admin tenant id = "platform"
  name      String
  email     String
  password  String
  role      String   @default("receptionist") // legacy role string (kept for compatibility)
  roleId     String? // molecular role id
  phone     String?
  avatar    String?
  active    Boolean  @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleRef     Role?      @relation(fields: [roleId], references: [id])
  property    Property?  @relation(fields: [propertyId], references: [id])
  propertyId  String?
  bookings    Booking[]
  payments    Payment[]
  expenses    Expense[]
  housekeeping HousekeepingTask[]
  auditLogs   AuditLog[]

  @@index([tenantId])
  @@index([roleId])
}

// ─── Rooms ──────────────────────────────────────────────────────────────────

model RoomType {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  basePrice   Float
  capacity    Int      @default(2)
  extraBedPrice Float  @default(0)
  amenities   String   @default("[]") // JSON array of amenity names
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rooms  Room[]
}

model Room {
  id          String   @id @default(cuid())
  tenantId    String
  propertyId  String
  number      String
  floor       Int      @default(1)
  roomTypeId  String
  status      String   @default("available") // available | occupied | reserved | cleaning | maintenance | blocked
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id])
  bookings Booking[]
  housekeeping HousekeepingTask[]

  @@unique([tenantId, propertyId, number])
  @@index([tenantId, status])
}

// ─── Guests ─────────────────────────────────────────────────────────────────

model Guest {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  mobile       String
  email        String?
  address      String?
  idType       String? // aadhaar | passport | driving_license | pan | voter
  idNumber     String?
  company      String?
  gstNumber    String?
  notes        String?
  blacklisted  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]
  payments Payment[]

  @@unique([tenantId, mobile])
  @@index([tenantId])
}

// ─── Bookings ───────────────────────────────────────────────────────────────

model Booking {
  id            String   @id @default(cuid())
  tenantId      String
  bookingCode   String
  guestId       String
  roomId        String
  source        String   @default("walk_in") // walk_in | online | phone | agent
  status        String   @default("confirmed") // confirmed | pending | checked_in | checked_out | cancelled | no_show
  checkIn       DateTime
  checkOut      DateTime
  adults        Int      @default(1)
  children      Int      @default(0)
  numGuests     Int      @default(1)
  extraBed      Boolean  @default(false)
  tariffPerDay  Float
  totalAmount   Float    @default(0)
  advancePaid   Float    @default(0)
  discount      Float    @default(0)
  taxRate       Float    @default(0) // percentage
  specialRequests String?
  checkInActual  DateTime?
  checkOutActual DateTime?
  cancelledAt   DateTime?
  cancellationReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest    Guest  @relation(fields: [guestId], references: [id])
  room     Room   @relation(fields: [roomId], references: [id])
  user     User?  @relation(fields: [createdBy], references: [id])
  createdBy String?
  payments Payment[]
  invoice  Invoice?

  @@index([tenantId, status])
  @@index([tenantId, checkIn])
  @@unique([tenantId, bookingCode])
}

// ─── Payments & Billing ─────────────────────────────────────────────────────

model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  bookingId   String?
  invoiceId   String?
  guestId     String?
  amount      Float
  method      String   @default("cash") // cash | upi | card | bank_transfer
  type        String   @default("advance") // advance | room | food | extra_bed | other | balance | refund
  reference   String?
  notes       String?
  status      String   @default("completed") // pending | completed | failed
  createdAt   DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  guest   Guest?  @relation(fields: [guestId], references: [id])
  user    User?    @relation(fields: [receivedBy], references: [id])
  receivedBy String?

  @@index([tenantId, createdAt])
  @@index([bookingId])
}

model Invoice {
  id           String   @id @default(cuid())
  tenantId     String
  invoiceCode  String
  bookingId    String   @unique
  guestId      String
  subtotal     Float
  discount     Float    @default(0)
  taxAmount    Float    @default(0)
  total        Float
  paidAmount   Float    @default(0)
  balance      Float    @default(0)
  status       String   @default("unpaid") // unpaid | partial | paid
  itemsJson    String   @default("[]") // JSON array of line items
  createdAt    DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([tenantId, createdAt])
  @@unique([tenantId, invoiceCode])
}

// ─── Expenses ───────────────────────────────────────────────────────────────

model Expense {
  id          String   @id @default(cuid())
  tenantId    String
  category    String   // utilities | salaries | supplies | maintenance | marketing | food | misc | platform_fee
  amount      Float
  description String?
  method      String   @default("cash")
  date        DateTime @default(now())
  receiptUrl  String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])
  userId String?

  @@index([tenantId, date])
}

// ─── Housekeeping ───────────────────────────────────────────────────────────

model HousekeepingTask {
  id          String   @id @default(cuid())
  tenantId    String
  roomId      String
  assignedTo  String?  // user id
  status      String   @default("pending") // pending | in_progress | done | inspection | blocked
  priority    String   @default("normal") // low | normal | high
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [assignedTo], references: [id])

  @@index([tenantId, status])
}

// ─── Notifications & Audit ──────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  type      String   // booking | check_in | check_out | payment | cancellation | maintenance | system | platform_fee
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, read])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
}

// ─── Subscriptions ──────────────────────────────────────────────────────────

model SubscriptionPlan {
  id          String  @id @default(cuid())
  name        String
  price       Float
  interval    String  @default("monthly") // monthly | yearly
  maxRooms    Int     @default(20)
  maxUsers    Int     @default(5)
  features    String  @default("[]") // JSON array
  active      Boolean @default(true)
  subscriptions TenantSubscription[]
}

model TenantSubscription {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  planId    String
  status    String   @default("active") // active | cancelled | past_due
  startedAt DateTime @default(now())
  endsAt    DateTime?

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])
}

// ─── Platform Fee System (Super Admin → Tenants) ────────────────────────────
//
// Super Admin configures a platform fee for each tenant (e.g. 5% of revenue, or
// a fixed monthly amount). Tenants owe platform-fee payments tracked here.

model PlatformFeeConfig {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  feeType     String   @default("percentage") // percentage | fixed_monthly | per_booking
  feeValue    Float    @default(5) // % of revenue OR fixed amount OR per-booking amount
  active      Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model PlatformFeePayment {
  id          String   @id @default(cuid())
  tenantId    String
  period      String   // "2026-08" (month) for monthly, or booking code for per-booking
  grossRevenue Float   @default(0) // revenue base for the period
  feeRate     Float    @default(0) // snapshot of the rate applied
  amountDue   Float    @default(0)
  amountPaid  Float    @default(0)
  status      String   @default("pending") // pending | partial | paid | overdue
  method      String?  // cash | upi | card | bank_transfer
  reference   String?
  dueDate     DateTime
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@unique([tenantId, period])
}
